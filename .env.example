# Root .env for `docker compose` (repo root, sibling to both subprojects).
# Copy to `.env` and fill in real values before `docker compose build` / `up`.
# See DEPLOY.md for the full runbook.
#
# This is for the VPS stack (docker-compose.yml). The local Docker Desktop
# stack (docker-compose.local.yml) needs NO .env at all — every value there
# has a working default. Create one only to override something; the two most
# useful locally are ADMIN_PASSWORD (below) and APP_PORT (host port, default
# 8080 — rebuild `web` after changing it).

# --- postgres ---
POSTGRES_USER=scas
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=erp_scas

# --- backend (api / migrate services) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Fails fast at boot if JWT_SECRET is unset/default while this is
# "production" — see backend config.py::assert_production_ready.
ENVIRONMENT=production
# Empty disables Sentry.
SENTRY_DSN=
# Used only by `docker compose run --rm seed` (first deploy): the admin
# account's password. Leave empty for a random one — every generated
# password (including this one) is written to ./seed_credentials.csv.
ADMIN_PASSWORD=
# JSON array string (pydantic-settings parses list-typed env vars as JSON).
CORS_ORIGINS=["https://your-domain.com"]
# Gunicorn worker count, read at container start (docker-compose.yml / api's
# Dockerfile CMD) — 2 workers * (db_pool_size 8 + db_max_overflow 4) = 24 max
# DB connections; keep this and postgres' max_connections (40) in sync if
# you change it. ~90 MB RAM per worker: 2 suits a 1 GB VPS.
WEB_CONCURRENCY=2
# Per-container memory caps (docker-compose.yml defaults, sized for 1 GB).
# Raise them on a bigger box; uncomment to override.
# API_MEM_LIMIT=450m
# WEB_MEM_LIMIT=250m
# WEB_HEAP_MB=160
# POSTGRES_MEM_LIMIT=256m
# REDIS_MEM_LIMIT=80m
# CADDY_MEM_LIMIT=96m

# --- frontend (web service) ---
# Baked into the web image at BUILD time (Next.js inlines NEXT_PUBLIC_* vars
# then, not at runtime) — changing this value requires `docker compose build
# web` again, not just a restart. Path-based routing (see Caddyfile), so
# this points at the same domain's /api prefix.
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# --- caddy ---
# Real domain Caddy will request a Let's Encrypt certificate for. Leaving
# this as a placeholder in production means Caddy can't get a cert. For
# local testing without a domain, see the commented :80 block at the bottom
# of ../Caddyfile instead of setting this to "localhost".
DOMAIN=your-domain.com
