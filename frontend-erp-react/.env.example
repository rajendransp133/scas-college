# Copy to .env.local for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Empty disables Sentry (client, server, and edge configs all read this —
# see instrumentation-client.ts / sentry.server.config.ts / sentry.edge.config.ts).
# Baked into the client bundle at BUILD time like NEXT_PUBLIC_API_URL, so a
# Docker rebuild is needed if this changes (see ../DEPLOY.md).
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to enable sourcemap upload to Sentry at build time — optional,
# the build succeeds without them (next.config.ts's withSentryConfig skips
# the upload step gracefully when authToken is unset).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
