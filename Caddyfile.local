# SCAS ERP — local (Docker Desktop) edge config, used by
# docker-compose.local.yml. Plain HTTP on the container's :80, published to
# the host as :8080.
#
# The production Caddyfile is the sibling `Caddyfile` — it terminates TLS for
# a real domain via Let's Encrypt, which cannot work against localhost. The
# routing below is otherwise identical, so what you exercise locally matches
# what runs in production.

{
	# When this stack sits behind a host reverse proxy (erp.scascollege.ac.in:
	# host nginx terminates TLS and forwards to 127.0.0.1:8080), every request
	# arrives from the Docker bridge gateway. Trusting private ranges makes
	# Caddy append to nginx's X-Forwarded-For instead of replacing it, so the
	# API's login rate limiter (rate_limit.py) still sees the real client.
	# Only safe because :8080 is published on loopback (APP_PORT in .env).
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# Path-based routing, same as production: /api/* goes to FastAPI with the
	# prefix stripped (handle_path), everything else to Next.js. This is why
	# NEXT_PUBLIC_API_URL is http://localhost:8080/api.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	# HSTS is deliberately omitted here — this listener is plain HTTP, and
	# sending HSTS on localhost would pin the browser to HTTPS for every
	# other localhost port you ever use. The rest of the production headers
	# apply unchanged.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-ancestors 'none'"
	}
}
