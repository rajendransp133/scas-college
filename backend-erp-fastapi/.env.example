# Copy to .env and adjust for your machine.
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost/erp_scas
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# "development" (default) or "production". Production refuses to boot with
# an unset/default JWT_SECRET — see config.py::assert_production_ready.
ENVIRONMENT=development

# Empty = single-process in-memory cache + in-memory rate limiting (fine for
# local dev). Set this once running more than one worker/replica.
REDIS_URL=

# Empty = Sentry disabled (local dev default).
SENTRY_DSN=
